# Copy this file to .env and fill in the values. Never commit .env.
# The Unity editor turns .env into Resources/AppSecrets.asset (gitignored) whenever scripts
# reload and before builds. Process environment variables with the same names take precedence
# (useful for CI). See Docs/Secrets.md.

# --- API keys (required for the related feature) ---

# Auki posemesh app credentials (https://console.auki.network)
AUKI_APP_KEY=
AUKI_APP_SECRET=

# Amplitude analytics (https://amplitude.com)
AMPLITUDE_API_KEY=

# Reown / WalletConnect project id (https://cloud.reown.com)
REOWN_PROJECT_ID=

# Alchemy API key for NFT ownership checks on Base (https://alchemy.com)
ALCHEMY_API_KEY=

# --- Deployment identity (optional) ---

# Posemesh domain the app joins by default (https://developer.aukilabs.com)
AUKI_DOMAIN_ID=
# Editor only: session to connect to when "Use This Session Id In Editor" is ticked in Auki Settings
AUKI_EDITOR_SESSION_ID=

# --- Android store builds (used by the Android build configuration only) ---

# Package name for Google Play; the tracked Player Settings keep a neutral placeholder
ANDROID_PACKAGE_NAME=
# Release keystore; leave empty to build with the debug keystore (Play rejects those)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASS=
ANDROID_KEYALIAS_PASS=
